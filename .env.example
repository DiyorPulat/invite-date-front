# Production backend URL. Leave empty in local development to use the Vite
# same-origin proxy (see VITE_API_PROXY_TARGET below).
VITE_API_BASE_URL=

# Local development proxy target:
VITE_API_PROXY_TARGET=http://localhost:8080

# If the frontend and backend are hosted on different domains in production,
# configure the backend CORS policy to allow all origins (CORS_ALLOWED_ORIGINS=*).
